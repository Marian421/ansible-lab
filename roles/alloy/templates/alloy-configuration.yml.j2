logging {
  level = "info"
}

loki.write "loki" {
  endpoint {
    url = "http://monitor01:3100/loki/api/v1/push"
  }
}

loki.source.journal "journal" {
  labels = {
    host = "{{ ansible_hostname }}",
    job  = "systemd",
  }

  forward_to = [loki.write.loki.receiver]
}

loki.source.syslog "syslog" {
  listener {
    address  = "0.0.0.0:1514"
    protocol = "tcp"
  }

  forward_to = [loki.write.loki.receiver]
}
